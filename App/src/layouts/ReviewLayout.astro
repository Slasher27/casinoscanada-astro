---
// src/layouts/ReviewLayout.astro
import BaseLayout from './BaseLayout.astro';
import SidebarCasinos from '../components/ui/SidebarCasinos.astro';
import CasinoHero from '../components/reviews/CasinoHero.astro';
import InfoWidgets from '../components/reviews/InfoWidgets.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import TableOfContents from '../components/reviews/TableOfContents.astro';
import MobileStickyCTA from '../components/reviews/MobileStickyCTA.astro';
import { getCasinoById } from '../db/queries';
import { parseJsonField } from '../types/database';

// 1. Define the Heading Interface explicitly
interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	frontmatter: any;
	headings?: Heading[]; // Use the defined type here
}

const { frontmatter, headings } = Astro.props;
const currentCasinoId = frontmatter.casinoId || frontmatter.id || '';

// Fetch casino data from database
const casino = currentCasinoId ? getCasinoById(currentCasinoId) : null;

// Parse pros/cons from JSON if casino exists
const casinoData = casino
	? {
			...casino,
			pros: parseJsonField<string[]>(casino.pros),
			cons: parseJsonField<string[]>(casino.cons),
		}
	: null;

// Generate Title Case from Slug (e.g. "bitstarz-casino" -> "Bitstarz Casino")
const rawSlug = Astro.url.pathname.split('/').filter(Boolean).pop() || '';
const formatSlug = (slug: string) => {
	return slug
		.split('-')
		.map((word) => word.charAt(0).toUpperCase() + word.slice(1))
		.join(' ');
};

const breadcrumbs = [
	{ text: 'Reviews', href: '/reviews/' },
	{ text: formatSlug(rawSlug), href: Astro.url.pathname },
];
---

<BaseLayout title={frontmatter.title} description={frontmatter.metaDescription}>
	{currentCasinoId && <MobileStickyCTA casinoId={currentCasinoId} />}

	<div class='w-full overflow-x-hidden'>
		<div class='container mx-auto px-4 md:px-6 lg:px-8 py-8'>
			<div class='mb-6' id='hero-sentinel'>
				<Breadcrumbs items={breadcrumbs} />
			</div>
			{
				currentCasinoId && (
					<CasinoHero casinoId={currentCasinoId} seoTitle={frontmatter.title} />
				)
			}

			{/* Info Widgets Grid - 3 columns on desktop */}
			{currentCasinoId && <InfoWidgets casinoId={currentCasinoId} />}

			<div class='grid grid-cols-1 lg:grid-cols-12 gap-12 mt-8'>
				<main
					class='lg:col-span-9 prose prose-lg max-w-none prose-headings:font-bold prose-a:text-blue-600 dark:prose-a:text-accent-400 prose-img:rounded-xl dark:prose-invert dark:prose-headings:text-white dark:prose-p:text-primary-300 dark:prose-li:text-primary-300 dark:prose-strong:text-white dark:prose-td:text-primary-300 dark:prose-th:text-white'
				>
					<slot />
				</main>

				<aside class='lg:col-span-3 space-y-8'>
					{/* Table of Contents */}
					{
						headings && headings.length > 0 && (
							<div class='hidden lg:block'>
								<TableOfContents headings={headings} />
							</div>
						)
					}

					{/* Similar Casinos Widget */}
					<SidebarCasinos excludeId={currentCasinoId} />
				</aside>
			</div>
		</div>
	</div>
</BaseLayout>
