---
import BaseLayout from '../layouts/BaseLayout.astro';
import CasinoTopList from '../components/ui/CasinoTopList.astro';
import SlotsSection from '../components/ui/SlotsSection.astro';
import BankingGrid from '../components/ui/BankingGrid.astro';
import { getCollection } from 'astro:content';

import CasinoWizard from '../components/interactive/CasinoWizard.svelte';

// Fetch only the 3 latest reviews for a "Recent Updates" section
const allReviews = await getCollection('reviews');
const latestReviews = allReviews.slice(0, 3);

// Data for Wizard
const wizardCasinos = allReviews.map((r) => ({
	id: r.data.casinoId,
	name: r.data.name,
	logo: r.data.logo,
	rating: r.data.rating,
	bonus: r.data.bonus_offer,
	tags: r.data.pros || [],
}));

// Schema.org structured data for homepage
const organizationSchema = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: 'Casinos Canada',
	url: 'https://casinoscanada.online',
	logo: 'https://casinoscanada.online/favicon.svg',
	description:
		'Independent reviews of online casinos for Canadian players. We test payout speeds, bonuses, and game fairness.',
	sameAs: [
		// Add social media profiles here when available
		// 'https://twitter.com/casinoscanada',
		// 'https://facebook.com/casinoscanada',
	],
	contactPoint: {
		'@type': 'ContactPoint',
		contactType: 'Customer Service',
		areaServed: 'CA',
		availableLanguage: ['English'],
	},
};

const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'Casinos Canada',
	url: 'https://casinoscanada.online',
	description:
		'Top-rated online casinos for Canadian players with honest reviews and fast payout testing.',
	publisher: {
		'@type': 'Organization',
		name: 'Casinos Canada',
	},
	potentialAction: {
		'@type': 'SearchAction',
		target: {
			'@type': 'EntryPoint',
			urlTemplate: 'https://casinoscanada.online/?q={search_term_string}',
		},
		'query-input': 'required name=search_term_string',
	},
};
---

<BaseLayout
	title='Best Online Casinos in Canada (2025) | Honest Reviews'
	description='Compare the top rated online casinos in Canada. We test payout speeds, bonuses, and licensing to ensure you play safely.'
>
	<!-- Schema.org JSON-LD -->
	<script
		type='application/ld+json'
		slot='head'
		set:html={JSON.stringify(organizationSchema)}
	/>
	<script
		type='application/ld+json'
		slot='head'
		set:html={JSON.stringify(websiteSchema)}
	/>

	<!-- Premium Hero Section -->
	<section
		class='relative min-h-[600px] flex items-center pt-24 pb-16 overflow-hidden bg-primary-950'
	>
		<!-- Background Effects -->
		<div class='absolute inset-0 z-0'>
			<div
				class='absolute top-[-10%] right-[-5%] w-[500px] h-[500px] bg-premium-purple-600/30 rounded-full blur-[100px] animate-pulse-slow'
			>
			</div>
			<div
				class='absolute bottom-[-10%] left-[-10%] w-[600px] h-[600px] bg-accent-600/20 rounded-full blur-[120px]'
			>
			</div>
			<div
				class="absolute inset-0 bg-[url('/images/hero-pattern.svg')] opacity-5"
			>
			</div>
		</div>

		<div class='container mx-auto px-4 relative z-10'>
			<div class='grid lg:grid-cols-2 gap-12 items-center'>
				<!-- Text Content -->
				<div class='text-center lg:text-left space-y-8'>
					<div
						class='inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-white/10 backdrop-blur-sm animate-fade-in'
					>
						<span class='w-2 h-2 rounded-full bg-green-500 animate-pulse'
						></span>
						<span
							class='text-xs text-primary-200 font-bold tracking-wide uppercase'
							>Updated for 2025</span
						>
					</div>

					<h1
						class='text-5xl lg:text-7xl font-black text-white tracking-tight leading-none'
					>
						Play <span
							class='bg-clip-text text-transparent bg-gradient-to-r from-premium-gold-300 to-premium-gold-500'
							>Smarter.</span
						><br />
						Win <span
							class='bg-clip-text text-transparent bg-gradient-to-r from-accent-400 to-accent-600'
							>Bigger.</span
						>
					</h1>

					<p
						class='text-xl text-primary-200 max-w-xl mx-auto lg:mx-0 leading-relaxed'
					>
						The #1 trusted resource for Canadian players. We verify payout
						speeds, audit game integrity, and negotiate exclusive bonuses.
					</p>

					<div
						class='flex flex-col sm:flex-row gap-4 justify-center lg:justify-start'
					>
						<a
							href='#top-list'
							class='bg-accent-600 hover:bg-accent-700 text-white font-bold py-4 px-8 rounded-full shadow-button hover:shadow-glow hover:scale-105 transition-all text-lg'
						>
							View Top Casinos
						</a>
						<a
							href='/bonuses/'
							class='bg-white/10 hover:bg-white/20 text-white border border-white/20 font-bold py-4 px-8 rounded-full backdrop-blur-sm transition-all text-lg'
						>
							Best Bonuses
						</a>
					</div>

					<!-- Trust Indicators -->
					<div
						class='pt-8 grid grid-cols-3 gap-6 border-t border-white/10 opacity-70'
					>
						<div>
							<div class='text-2xl font-black text-white'>50+</div>
							<div class='text-xs text-primary-400 uppercase tracking-widest'>
								Sites Tested
							</div>
						</div>
						<div>
							<div class='text-2xl font-black text-white'>98%</div>
							<div class='text-xs text-primary-400 uppercase tracking-widest'>
								Satisfaction
							</div>
						</div>
						<div>
							<div class='text-2xl font-black text-white'>$5M+</div>
							<div class='text-xs text-primary-400 uppercase tracking-widest'>
								Bonuses
							</div>
						</div>
					</div>
				</div>

				<!-- Wizard / Interactive Element -->
				<div
					class='hidden lg:block animate-slide-up'
					style='animation-delay: 0.2s;'
				>
					<CasinoWizard client:load casinos={wizardCasinos} />
				</div>
			</div>
		</div>
	</section>

	<div id='top-list' class='container mx-auto px-4 -mt-10 relative z-20 mb-20'>
		<CasinoTopList />
	</div>

	<SlotsSection />

	<BankingGrid />

	<section
		class='py-16 bg-gray-50 dark:bg-primary-950 border-t border-gray-200 dark:border-primary-800'
	>
		<div class='container mx-auto px-4'>
			<div class='flex justify-between items-end mb-10'>
				<div>
					<h2 class='text-3xl font-bold text-gray-900 dark:text-white'>
						Latest Reviews
					</h2>
					<p class='text-gray-600 dark:text-primary-400 mt-2'>
						Freshly tested by our team.
					</p>
				</div>
				<a
					href='/reviews/'
					class='text-accent-600 dark:text-accent-400 font-bold hover:underline'
					>View All &rarr;</a
				>
			</div>

			<div class='grid grid-cols-1 md:grid-cols-3 gap-8'>
				{
					latestReviews.map((review) => (
						<a
							href={`/reviews/${review.slug}/`}
							class='group bg-white dark:bg-primary-800 rounded-xl shadow-sm border border-gray-100 dark:border-primary-700 overflow-hidden hover:shadow-lg transition-all'
						>
							<div class='p-6'>
								<div class='flex items-center gap-2 mb-3'>
									<span class='text-xs font-bold uppercase tracking-wider text-gray-400 dark:text-primary-400'>
										Review
									</span>
									<span class='text-xs font-bold text-yellow-600 dark:text-yellow-400'>
										★ {review.data.rating}/5
									</span>
								</div>
								<h3 class='font-bold text-xl text-gray-900 dark:text-white group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors mb-2'>
									{review.data.title.split(':')[0]}
								</h3>
								<p class='text-gray-600 dark:text-primary-400 text-sm line-clamp-2'>
									{review.data.metaDescription}
								</p>
							</div>
						</a>
					))
				}
			</div>
		</div>
	</section>
</BaseLayout>
