---
import { getCasinoById } from '../../db/queries';
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';

interface Props {
	casinoId: string;
}

const { casinoId } = Astro.props;
const casino = getCasinoById(casinoId);

if (!casino || !casino.website_url) return null;
---

<div
	id='mobile-sticky-cta'
	class='fixed bottom-0 left-0 w-full bg-primary-900 border-t border-primary-700 shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.3)] p-card-sm transform translate-y-full transition-transform duration-300 z-50 lg:hidden flex items-center justify-between gap-4'
>
	<div class='flex items-center gap-3'>
		<img
			src={casino.logo_url}
			alt={casino.name}
			class='w-14 h-14 object-contain rounded-full bg-white p-0.5'
		/>
		<div>
			<div class='font-bold text-white leading-tight mb-1'>
				{casino.name}
			</div>
			<div class='flex items-center gap-1 text-body-sm'>
				<Badge variant="bonus" size="sm">
					★ {casino.rating}/5
				</Badge>
			</div>
		</div>
	</div>

	<Button
		href={casino.website_url}
		variant="primary"
		size="sm"
		external
	>
		Play Now
	</Button>
</div>

<script>
	const initStickyCTA = () => {
		const cta = document.getElementById('mobile-sticky-cta');
		const trigger = document.getElementById('hero-sentinel'); // We will add this ID to the hero or a marker

		if (!cta) return;

		// Fallback trigger if sentinel not found (e.g. scroll 500px)
		const scrollThreshold = 600;

		const onScroll = () => {
			const scrollY = window.scrollY;

			// Show if scrolled past threshold
			if (scrollY > scrollThreshold) {
				cta.classList.remove('translate-y-full');
			} else {
				cta.classList.add('translate-y-full');
			}
		};

		window.addEventListener('scroll', onScroll, { passive: true });
	};

	document.addEventListener('astro:page-load', initStickyCTA);
	document.addEventListener('DOMContentLoaded', initStickyCTA);
</script>
