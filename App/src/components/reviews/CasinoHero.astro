---
// src/components/reviews/CasinoHero.astro
import { getCasinoById } from '../../db/queries';
import EntityHero from '../common/EntityHero.astro';
import FeatureBadge from '../ui/FeatureBadge.astro';

interface Props {
	casinoId: string;
	seoTitle?: string;
}

const { casinoId, seoTitle } = Astro.props;

const casino = getCasinoById(casinoId);

if (!casino) {
	console.error(`Error: Casino ID "${casinoId}" not found in DB.`);
}
---

{
	casino && (
		<EntityHero
			title={seoTitle || `${casino.name} Review`}
			subtitle='Updated for Canadian Players'
			logoUrl={casino.logo_url}
			stats={[
				{
					label: 'Payout',
					value: `${casino.payout_speed_minutes} mins`,
					icon: '⚡',
				},
				{
					label: 'License',
					value: casino.license,
					icon: '🛡️',
				},
				{
					label: 'RTP',
					value: `${casino.payout_ratio}%`,
					icon: '📈',
					color: 'text-green-400',
				},
			]}
		>
			<div
				slot='action'
				class='bg-primary-900/50 p-4 rounded-2xl border border-primary-700/50 text-center w-full md:w-auto'
			>
				<div class='text-sm text-primary-300 font-bold mb-1'>
					Exclusive Bonus
				</div>
				<div class='text-2xl md:text-3xl font-black text-bonus-400 mb-4 leading-tight max-w-[200px] mx-auto'>
					{casino.bonus_offer}
				</div>
				<a
					href={casino.website_url}
					target='_blank'
					rel='nofollow noopener'
					class='inline-block w-full md:w-auto bg-accent-600 hover:bg-accent-700 text-white font-bold py-3 px-8 rounded-btn-primary shadow-button transform hover:scale-105 transition-all'
				>
					Play Now
				</a>
			</div>

			<div
				slot='footer'
				class='mt-6 pt-6 border-t border-slate-700/50 flex flex-col md:flex-row md:items-center md:justify-between gap-4'
			>
				{/* Feature Badges - Left Side */}
				<div class='flex flex-wrap gap-x-6 gap-y-2'>
					<FeatureBadge
						label='Sports Betting'
						available={Boolean(casino.sports_betting)}
					/>
					<FeatureBadge label='Poker' available={Boolean(casino.poker)} />
					<FeatureBadge
						label='Live Casino'
						available={Boolean(casino.live_casino)}
					/>
					<FeatureBadge
						label='Mobile App'
						available={Boolean(casino.mobile_app)}
					/>
				</div>

				{/* Verification Info - Right Side */}
				<div class='flex flex-wrap gap-4 text-xs text-slate-400 font-medium'>
					<div class='flex items-center gap-1.5'>
						<span class='text-success-400'>✓</span> Verified by Casinos Canada
					</div>
					<div class='flex items-center gap-1.5'>
						<span class='text-blue-400'>🛡️</span> Licensed & Regulated
					</div>
					<div class='flex items-center gap-1.5'>
						<span class='text-slate-400'>📅</span> Last Checked: January 2025
					</div>
				</div>
			</div>
		</EntityHero>
	)
}
