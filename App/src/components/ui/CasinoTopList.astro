---
import { db } from '../../db/client';
import Button from './Button.astro';
import Badge from './Badge.astro';
import Heading from './Heading.astro';
import { getCollection } from 'astro:content';

// 1. Define Types
type Entity = { id: string; name: string; logo_url: string };

type Casino = {
	id: string;
	name: string;
	website_url: string;
	payout_ratio: number;
	payout_speed_minutes: number;
	logo_url: string;
	bonus_offer: string;
	bonus_spins: number;
    license: string;
	payments?: Entity[];
    software?: Entity[];
    min_deposit?: number;
};

// 2. Fetch Reviews (sorted by rating)
const allReviews = await getCollection('reviews');
const topReviews = allReviews
	.sort((a, b) => b.data.rating - a.data.rating)
	.slice(0, 10);

const casinoIds = topReviews.map((r) => r.data.casinoId);

// 3. Get all unique payment method and software provider IDs
const allPaymentIds = [...new Set(topReviews.flatMap(r => r.data.payment_methods || []))];
const allSoftwareIds = [...new Set(topReviews.flatMap(r => r.data.software_providers || []))];

// 4. Fetch payment method and software provider metadata (logos, names)
const paymentMethodsMap = new Map<string, Entity>();
const softwareProvidersMap = new Map<string, Entity>();

if (allPaymentIds.length > 0) {
	const placeholders = allPaymentIds.map(() => '?').join(',');
	const payments = db.prepare(`
		SELECT id, name, logo_url FROM payment_methods WHERE id IN (${placeholders})
	`).all(...allPaymentIds) as Entity[];
	payments.forEach(p => paymentMethodsMap.set(p.id, p));
}

if (allSoftwareIds.length > 0) {
	const placeholders = allSoftwareIds.map(() => '?').join(',');
	const software = db.prepare(`
		SELECT id, name, logo_url FROM software_providers WHERE id IN (${placeholders})
	`).all(...allSoftwareIds) as Entity[];
	software.forEach(s => softwareProvidersMap.set(s.id, s));
}

// 5. Transform reviews into Casino format for rendering
const topCasinos = topReviews.map((review) => {
	const payments = (review.data.payment_methods || [])
		.map(id => paymentMethodsMap.get(id))
		.filter(Boolean)
		.slice(0, 5);

	const software = (review.data.software_providers || [])
		.map(id => softwareProvidersMap.get(id))
		.filter(Boolean)
		.slice(0, 4);

	return {
		id: review.data.casinoId,
		name: review.data.name,
		website_url: review.data.website,
		payout_ratio: review.data.rtp,
		payout_speed_minutes: review.data.withdrawal_speed,
		logo_url: review.data.logo,
		bonus_offer: review.data.bonus_offer,
		bonus_spins: review.data.bonus_spins,
		license: review.data.license,
		payments: payments as Entity[],
		software: software as Entity[],
		min_deposit: review.data.min_deposit
	};
});

const FALLBACK_ICON = 'data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0iIzlDQTNBRiI+PHBhdGggZD0iTTEyIDFMMyA1djZjMCA1LjU1IDMuODQgMTAuNzQgOSAxMiA1LjE2LTEuMjYgOS02LjQ1IDktMTJWNWwtOS00em0wIDEwLjk5aDdjLS41MyA0LjEyLTMuMjggNy43OS03IDguOTRWMTJINVY2LjNsNy0zLjExdjguOHoiLz48L3N2Zz4=';
---

<div class='flex flex-col gap-4'>
	<!-- Desktop Header -->
	<div class='hidden lg:grid grid-cols-12 gap-4 bg-primary-50 dark:bg-primary-900 p-card-sm rounded-t-card text-xs font-bold text-primary-600 dark:text-primary-300 uppercase tracking-wider border-b border-primary-200 dark:border-primary-800'>
		<div class='col-span-1 text-center'>Rank</div>
		<div class='col-span-4'>Casino & Key Stats</div>
		<div class='col-span-3'>Software & Banking</div>
		<div class='col-span-2 text-center'>Bonus</div>
		<div class='col-span-2 text-center'>Action</div>
	</div>

	{topCasinos.map((casino, index) => (
		<div class='bg-white dark:bg-primary-800 rounded-card shadow-card border border-primary-200 dark:border-primary-700 overflow-hidden hover:shadow-card-hover transition-shadow relative'>

			<!-- MOBILE / TABLET VIEW (< 1024px) -->
			<div class='lg:hidden p-card flex flex-col gap-4'>
                <!-- Top Row: Logo, Rank, Name, Info -->
				<div class='flex items-start gap-4'>
                    <!-- Rank Badge -->
                    <div class='absolute top-0 left-0 bg-primary-900 dark:bg-primary-950 text-white text-xs font-bold px-3 py-1 rounded-br-lg z-10'>
                        #{index + 1}
                    </div>

					<div class='w-24 h-24 flex-shrink-0 flex items-center justify-center mt-2 overflow-hidden rounded-card bg-white dark:bg-primary-900/50'>
						<img
							src={casino.logo_url || FALLBACK_ICON}
							alt={casino.name}
							class='w-full h-full object-contain rounded-card'
							onerror={`this.onerror=null; this.src='${FALLBACK_ICON}';`}
						/>
					</div>
					<div class="flex-grow pt-1">
						<Heading level={3} as="card-title" class="mb-1 dark:text-white">
							{casino.name}
						</Heading>
                        <div class="flex flex-wrap gap-2 mb-2">
                            <Badge variant="neutral" size="sm">{casino.license}</Badge>
                            <Badge variant="success" size="sm">
                                RTP {casino.payout_ratio}%
                            </Badge>
                        </div>
                        <Button
							href={`/reviews/${casino.id}-casino/`}
							variant="link"
							class='text-sm'
						>
                            Read Review &rarr;
                        </Button>
					</div>
				</div>

                <!-- Middle: Bonus Box -->
				<div class='bg-bonus-50 dark:bg-bonus-900/10 border border-bonus-100 dark:border-bonus-900/20 rounded-btn p-3 text-center'>
					<span class='block text-xs font-bold text-bonus-700 dark:text-bonus-400 uppercase tracking-wide mb-1'>Welcome Bonus</span>
					<span class='block text-lg font-black text-primary-900 dark:text-white'>{casino.bonus_offer}</span>
				</div>

                <!-- Bottom: Specs & CTA -->
				<div class='flex flex-wrap items-center justify-between gap-4 border-t border-primary-200 dark:border-primary-700 pt-3'>
                    <div class="flex flex-col gap-1">
                        <span class="text-xs text-primary-600 dark:text-primary-400 font-bold">Fast Payouts</span>
                         <span class="text-sm font-bold text-primary-700 dark:text-primary-300">⚡ {casino.payout_speed_minutes} mins</span>
                    </div>
					<Button
						href={casino.website_url}
						variant="primary"
						size="md"
						fullWidth
						class="sm:flex-grow-0"
					>
						Play Now
					</Button>
				</div>

                <!-- Expanded Info (Tablet Optimization) -->
                <div class="hidden sm:flex items-center gap-2 pt-2 overflow-hidden opacity-75">
                     <span class="text-xs font-bold text-primary-600">Software:</span>
                     {casino.software?.slice(0, 6).map(s => (
                        <img src={s.logo_url} class="w-12 h-6 object-contain rounded-md bg-white p-0.5 grayscale" alt={s.name} />
                     ))}
                </div>
			</div>

			<!-- DESKTOP VIEW (>= 1024px) -->
			<div class='hidden lg:grid grid-cols-12 gap-4 items-center p-card-sm min-h-[100px]'>

                <!-- Rank -->
                <div class='col-span-1 flex justify-center'>
					<div class='w-10 h-10 rounded-badge bg-primary-100 dark:bg-primary-900 text-primary-600 dark:text-primary-300 font-black text-lg flex items-center justify-center border border-primary-200 dark:border-primary-700'>
						{index + 1}
					</div>
				</div>

				<!-- Info -->
                <div class='col-span-4 flex items-center gap-4'>
					<div class='w-24 h-24 flex-shrink-0 flex items-center justify-center overflow-hidden rounded-card bg-white dark:bg-primary-900/50'>
						<img
							src={casino.logo_url || FALLBACK_ICON}
							alt={casino.name}
							class='w-full h-full object-contain rounded-card'
							onerror={`this.onerror=null; this.src='${FALLBACK_ICON}';`}
						/>
					</div>
					<div>
						<h3 class='text-xl font-bold text-primary-900 dark:text-white leading-none'>
							<a href={`/reviews/${casino.id}-casino/`} class='hover:text-accent-600 dark:hover:text-accent-400 transition-colors'>
								{casino.name}
							</a>
						</h3>
						<div class='flex items-center gap-2 mt-1'>
                            <Badge variant="neutral" size="sm">
                                {casino.license}
                            </Badge>
                            <Badge variant="success" size="sm" border={false}>
                                💰 Min ${casino.min_deposit}
                            </Badge>
                            <Badge variant="info" size="sm" border={false}>
                                📈 {casino.payout_ratio}%
                            </Badge>
						</div>
					</div>
				</div>

                <!-- Logos (Software & Banking Mixed) -->
				<div class='col-span-3 flex flex-col justify-center gap-3'>
                   <div class="flex items-center gap-2 overflow-hidden">
                       <span class="text-[10px] uppercase font-bold text-primary-600 dark:text-primary-400 w-12 shrink-0">Games</span>
                       {casino.software?.map(s => (
                           <img src={s.logo_url} title={s.name} alt={s.name} class="w-20 h-10 object-contain rounded-md bg-white p-1 grayscale hover:grayscale-0 opacity-80 hover:opacity-100 transition-all cursor-help" />
                       ))}
                   </div>
                   <div class="flex items-center gap-2 overflow-hidden">
                       <span class="text-[10px] uppercase font-bold text-primary-600 dark:text-primary-400 w-12 shrink-0">Bank</span>
                       {casino.payments?.map(p => (
                           <img src={p.logo_url} title={p.name} alt={p.name} class="h-6 w-auto object-contain" />
                       ))}
                   </div>
				</div>

                <!-- Bonus -->
				<div class='col-span-2 text-center flex flex-col justify-center'>
					<span class='font-bold text-primary-900 dark:text-white text-lg leading-tight'>{casino.bonus_offer}</span>
					{(casino.bonus_spins || 0) > 0 && (
						<Badge variant="accent" size="sm" class="mt-1 inline-block mx-auto">
							+ {casino.bonus_spins} Free Spins
						</Badge>
					)}
				</div>

                <!-- CTA -->
				<div class='col-span-2 flex flex-col gap-2 justify-center text-center'>
					<Button
						href={casino.website_url}
						variant="primary"
						size="md"
					>
						Play Now
					</Button>
                    <Button
						href={`/reviews/${casino.id}-casino/`}
						variant="link"
						class='text-xs'
					>
                        View Review
                    </Button>
				</div>
			</div>
		</div>
	))}
</div>
